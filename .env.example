# Hosted LLM (receives only redacted / aggregated data)
OPENAI_API_KEY=
MODEL_NAME=

# Local model (raw personal text never leaves the machine)
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=
LOCAL_EMBEDDING_MODEL=

# Set to true to disable all hosted-model calls
LOCAL_ONLY_MODE=false

# One connection per database role; matches docker-compose.yml for local development.
# Application (lumen_app): user data, always through row-level security
DATABASE_URL=postgresql+psycopg://lumen_app:lumen_app@localhost:5432/lumen
# Auth service (lumen_auth): users + auth schema
AUTH_DATABASE_URL=postgresql+psycopg://lumen_auth:lumen_auth@localhost:5432/lumen
# Migrations and dev tooling (owner; bypasses row-level security)
ADMIN_DATABASE_URL=postgresql+psycopg://lumen:lumen@localhost:5432/lumen
TEST_DATABASE_URL=postgresql+psycopg://lumen:lumen@localhost:5432/lumen_test

# Sessions (ISO 8601 durations)
SESSION_IDLE_TIMEOUT=PT12H
SESSION_ABSOLUTE_TIMEOUT=P7D
SESSION_TOUCH_INTERVAL=PT5M

# HTTP API (spec 001). Required: at least 32 bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
ALLOWED_ORIGINS=["http://localhost:5173"]
# Chrome and Firefox accept Secure cookies on http://localhost; Safari doesn't, so set this to false to use it locally.
COOKIE_SECURE=true
# Built frontend for FastAPI to serve; `make run` sets this itself.
# WEB_DIST=web/dist

# The local model behind free-text check-ins (spec 006). The app refuses anything that isn't on
# this machine: OLLAMA_URL must be a loopback address, and OLLAMA_MODEL can't be a cloud model.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:26b
