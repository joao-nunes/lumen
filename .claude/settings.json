{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/review_gate.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" check",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/review_gate.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" record",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
